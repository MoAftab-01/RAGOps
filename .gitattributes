# Normalise line endings on checkin so a Windows checkout does not produce a
# whole-file diff on Linux, and vice versa. Without this, git's default
# `core.autocrlf=true` on Windows turns every .py file into a 100% diff for
# anyone who clones on another platform.
* text=auto

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sql   text eol=lf
Makefile text eol=lf

# The Makefile invokes bash and docker compose; CRLF breaks both.
*.sh    text eol=lf

# Windows entrypoints legitimately want CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touched.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.faiss binary
*.npy   binary
*.npz   binary
*.pkl   binary