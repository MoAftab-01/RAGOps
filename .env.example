# ==============================================================================
# RAGOps — example environment file
# ==============================================================================
#
# Copy this to `.env` and edit it:
#
#     Copy-Item .env.example .env          # PowerShell (Windows)
#     cp .env.example .env                # bash (Linux / macOS / WSL)
#
# `.env` is in .gitignore and MUST NEVER be committed. This file is the
# template that is committed; it holds no real credentials.
#
# Every variable below is optional. RAGOps boots with no .env at all, using
# the defaults in backend/app/config.py, which are tuned for the Docker Compose
# stack. You only need this file when running services outside Docker, or when
# you want to change a default.
#
# Precedence: real environment variables > .env file > code defaults.
# ==============================================================================


# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# APP_NAME=RAGOps

# One of: development | test | production
# ENVIRONMENT=development

# Never enable debug in production -- it surfaces stack traces and SQL to the
# browser, and the API logs request bodies.
# DEBUG=true

# One of: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
#
# These are the defaults for the docker-compose.yml services. If you changed the
# POSTGRES_* values there, change these to match.

# The async driver is what the application itself connects with.
# DATABASE_URL=postgresql+asyncpg://ragops:ragops@localhost:5432/ragops

# The synchronous driver is used by Alembic migrations and by scripts that
# cannot run inside the async engine. Same database, different driver.
# DATABASE_SYNC_URL=postgresql+psycopg://ragops:ragops@localhost:5432/ragops

# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Logs every SQL statement. Very noisy; development only.
# DB_ECHO=false


# ------------------------------------------------------------------------------
# Redis (cache)
# ------------------------------------------------------------------------------

# REDIS_URL=redis://localhost:6379/0

# How long an analytics query result stays cached, in seconds.
# CACHE_TTL_SECONDS=60


# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
#
# RAGOps uses a single shared API key. It is a *local* convenience control --
# it stops a stray process on your machine from reading your traces -- not a
# production identity system. Do not put a real secret in a committed file.
#
# If you change RAGOPS_API_KEY, change it here and in the frontend's .env too
# (VITE_RAGOPS_API_KEY), or the UI will get 401s.
#
# Set AUTH_ENABLED=false to run with no key at all while developing.

# Generate your own rather than reusing this default:
#   PowerShell : [System.Guid]::NewGuid().ToString()
#   Python     : python -c "import secrets; print(secrets.token_urlsafe(32))"
# RAGOPS_API_KEY=dev-key

# AUTH_ENABLED=true

# Comma-separated list of origins allowed to call the API from a browser.
# Keep this narrow. "*" disables the browser's same-origin protection entirely,
# so any page the user visits could read your traces.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# ------------------------------------------------------------------------------
# Ollama (the LLM — free and local)
# ------------------------------------------------------------------------------
#
# §2 requires that RAGOps run with no paid API. Ollama is the local provider.
# Start it with `ollama serve`, then pull the model once:
#
#     ollama pull qwen2.5:3b
#
# The Ollama API is unauthenticated by default, so there is no key here to set.

# OLLAMA_BASE_URL=http://localhost:11434

# A small, fast, free model. See docs/README for larger local options.
# OLLAMA_MODEL=qwen2.5:3b

# OLLAMA_TIMEOUT_SECONDS=120.0

# Context window requested from the model. Smaller means faster and less RAM.
# OLLAMA_NUM_CTX=8192

# The evaluation and chat paths use near-greedy decoding on purpose: a
# reproducible answer is what makes an evaluation run comparable to the last one.
# OLLAMA_TEMPERATURE=0.1


# ------------------------------------------------------------------------------
# Embeddings and reranking (local models)
# ------------------------------------------------------------------------------
#
# These download from Hugging Face on first use and are then cached on disk
# (~90 MB and ~90 MB respectively). No API key is needed and nothing is sent
# anywhere: the model runs in this process.

# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# auto | cpu | cuda
# EMBEDDING_DEVICE=auto

# EMBEDDING_BATCH_SIZE=32

# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_ENABLED=true
# RERANKER_TOP_N=20


# ------------------------------------------------------------------------------
# Vector store
# ------------------------------------------------------------------------------
#
# FAISS runs in-process and needs no server, so it is the default and works on a
# clean checkout. Switch to "qdrant" to use the docker-compose qdrant service.

# faiss | qdrant
# VECTOR_STORE_BACKEND=faiss

# Only read when VECTOR_STORE_BACKEND=qdrant.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=ragops_documents


# ------------------------------------------------------------------------------
# Chunking and retrieval
# ------------------------------------------------------------------------------
#
# chunk_overlap must be strictly smaller than chunk_size — a splitter that
# accepts overlap >= size can never advance its window.

# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# Top-K used when a request does not specify one.
# DEFAULT_TOP_K=5

# Reciprocal Rank Fusion constant. 60 is the value from Cormack et al. 2009;
# 0 is unweighted RRF, which weights the first rank much more heavily.
# HYBRID_RRF_K=60


# ------------------------------------------------------------------------------
# Telemetry collector (the SDK's flush buffer)
# ------------------------------------------------------------------------------

# COLLECTOR_ENABLED=true
# COLLECTOR_BUFFER_SIZE=200
# COLLECTOR_FLUSH_INTERVAL_SECONDS=2.0


# ------------------------------------------------------------------------------
# Anomaly detection
# ------------------------------------------------------------------------------
#
# IsolationForest needs enough samples to fit; below the minimum it reports
# "insufficient data" rather than a fabricated anomaly list.

# Expected fraction of points the model should flag as anomalous.
# ANOMALY_CONTAMINATION=0.02

# ANOMALY_MIN_SAMPLES=50


# ------------------------------------------------------------------------------
# LLM-as-judge (answer evaluation)
# ------------------------------------------------------------------------------
#
# OFF by default, and the flag matters: §35 forbids blindly trusting an LLM
# judge. Every judge score RAGOps records is kept alongside the prompt, the raw
# response and the model that produced it, so a score can be audited. Judge
# scores are never used for deterministic numbers — token counts, Precision@K,
# Recall@K, MRR and NDCG are all computed, not asked for.

# LLM_JUDGE_ENABLED=false
# LLM_JUDGE_MODEL=qwen2.5:3b

# Cap on claims extracted per answer, so one pathological answer cannot run
# thousands of judge calls.
# JUDGE_MAX_CLAIMS=12

# Groundedness checks below this similarity are treated as unsupported.
# GROUNDING_SIMILARITY_THRESHOLD=0.55


# ------------------------------------------------------------------------------
# Cost analytics
# ------------------------------------------------------------------------------
#
# IMPORTANT: RAGOps has no billing relationship with any model provider. The
# price table is a published, editable, clearly-labelled reference used to turn
# token counts into a comparable number. Every cost figure in the UI is derived
# from it and labelled SIMULATED. Turn it off to show token counts only.

# PRICING_ENABLED=true
# PRICING_CURRENCY=USD


# ------------------------------------------------------------------------------
# Analytics cache
# ------------------------------------------------------------------------------

# ANALYTICS_CACHE_ENABLED=true
# ANALYTICS_CACHE_TTL_SECONDS=30


# ------------------------------------------------------------------------------
# Paths (relative to the repository root)
# ------------------------------------------------------------------------------

# KNOWLEDGE_BASE_PATH=evaluation/datasets/knowledge_base
# EVALUATION_DATASET_PATH=evaluation/datasets/retrieval_eval.jsonl


# ------------------------------------------------------------------------------
# Frontend (Vite — must be VITE_ prefixed to reach the browser)
# ------------------------------------------------------------------------------
#
# Put these in frontend/.env, not here: Vite only exposes VITE_-prefixed
# variables from the directory it is served from.
#
#   VITE_API_URL=http://localhost:8000
#   VITE_RAGOPS_API_KEY=<same value as RAGOPS_API_KEY above>


# ------------------------------------------------------------------------------
# Docker Compose only — not read by the application directly
# ------------------------------------------------------------------------------
#
# docker-compose.yml interpolates these into the postgres service. They are the
# credentials for a container bound to localhost on a throwaway development
# volume; they are not production credentials and nothing outside your machine
# should ever reach that port.

# POSTGRES_USER=ragops
# POSTGRES_PASSWORD=ragops
# POSTGRES_DB=ragops